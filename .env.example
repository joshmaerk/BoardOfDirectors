# =============================================================================
# conductor (CLI) — Anthropic API directly
# =============================================================================
ANTHROPIC_API_KEY=

# =============================================================================
# app (HTTP API for Streamlit)
# =============================================================================

# --- Entra (Azure AD) ---
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
# Audience the API expects in the JWT (App-Registration client id or api://<id>)
AZURE_API_AUDIENCE=api://board-of-directors
# Optional CSV allow-list of tenant ids accepted in `tid`. Empty = use AZURE_TENANT_ID.
AZURE_ALLOWED_TENANTS=
# Optional CSV of role names required for board.* endpoints (empty = any authenticated user)
REQUIRED_API_ROLES=

# --- Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=replace-me
AZURE_OPENAI_API_VERSION=2024-10-21
# JSON map of logical model name -> Azure deployment name
AZURE_OPENAI_DEPLOYMENTS={"gpt-4o":"gpt-4o","gpt-4o-mini":"gpt-4o-mini"}

# --- Azure AI Foundry (Claude via Models-as-a-Service) ---
AZURE_AI_FOUNDRY_ENDPOINT=https://your-foundry-project.services.ai.azure.com
# Optional: API-Key fallback. If empty, DefaultAzureCredential is used.
AZURE_AI_FOUNDRY_API_KEY=
# JSON map of logical model name -> Foundry deployment name
AZURE_AI_FOUNDRY_DEPLOYMENTS={"claude-sonnet-4-5":"claude-sonnet-4-5","claude-opus-4-7":"claude-opus-4-7"}

# Provider routing. Model-name pattern -> provider id.
# Patterns match by prefix. First match wins.
LLM_PROVIDER_MAP={"gpt-":"azure-openai","claude-":"azure-anthropic"}

# --- Database ---
DATABASE_URL=postgresql+asyncpg://bod:bod@localhost:5432/bod

# --- API ---
ALLOWED_ORIGINS=http://localhost:8501
LOG_LEVEL=INFO
# Disable bearer-token validation for local dev only. Never set in prod.
AUTH_DEV_BYPASS=false
# Set to false in prod to hide /docs, /redoc and /openapi.json.
EXPOSE_OPENAPI_DOCS=true

# --- Run queue ---
# "in-process" runs jobs on the API event loop (dev / single replica).
# "arq" pushes them onto Redis so a separate worker container picks them up
# (production: restart-safe, scales horizontally).
RUN_QUEUE_BACKEND=in-process
REDIS_URL=redis://localhost:6379/0

# --- Rate limits (slowapi syntax, per user; falls back to IP if anonymous) ---
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_RUNS=30/hour

# --- Idempotency-Key TTL for POST /runs (seconds) ---
IDEMPOTENCY_TTL_SECONDS=86400

# --- Observability ---
# Optional: when set, OpenTelemetry exports traces/metrics to Azure Monitor.
# Leave empty to keep the SDK loaded without an exporter (still useful in dev
# because it instruments FastAPI/SQLAlchemy/HTTPx).
APPLICATIONINSIGHTS_CONNECTION_STRING=
OTEL_SERVICE_NAME=board-of-directors-api

# --- Secrets ---
# Optional: when set, env values formatted as `@kv:<secret-name>` are
# resolved against this Key Vault at startup via DefaultAzureCredential.
AZURE_KEY_VAULT_URL=
